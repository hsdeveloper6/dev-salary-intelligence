# Data: ignore every CSV by default
*.csv
vocab_*.csv

# data/ holds raw downloads (salary_intel.download_data) and everything rebuilt
# from them: data/premerge_cleaned_dataset/ (salary_intel.build_premerge),
# data/harmonized/ (salary_intel.build_harmonized) and data/cleaned_v2/
# (salary_intel.build_cleaned_v2). None of it is tracked.
data/

# Generated outputs
combined/
results/

# Tooling
.DS_Store
.ipynb_checkpoints/
__pycache__/
*.egg-info/
.venv/

# CatBoost training logs (only written if allow_writing_files is left on)
catboost_info/
