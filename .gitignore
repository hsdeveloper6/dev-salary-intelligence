# Data: ignore every CSV by default
*.csv
vocab_*.csv

# data/ holds raw downloads and rebuilt files (ignored) plus one merge input
# that no code in this repo can recreate yet, so it stays tracked (see README,
# roadmap 1b). Rebuilt by code: data/harmonized/ (salary_intel.build_harmonized)
# and data/cleaned_v2/ (salary_intel.build_cleaned_v2).
# Git can't re-include a file whose parent folder is ignored, so ignore the
# folder's contents (data/*) and re-include the kept folder, then its CSVs.
data/*
!data/premerge_cleaned_dataset/
!data/premerge_cleaned_dataset/*.csv

# Generated outputs
combined/
results/

# Tooling
.DS_Store
.ipynb_checkpoints/
__pycache__/
*.egg-info/
.venv/
