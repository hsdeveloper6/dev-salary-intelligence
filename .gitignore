# Data: ignore every CSV by default
*.csv
vocab_*.csv

# data/ holds raw downloads and rebuilt files (ignored) plus merge inputs that
# no code in this repo can recreate yet, so they stay tracked (see README,
# roadmap 1b). data/harmonized/ is rebuilt by salary_intel.build_harmonized.
# Git can't re-include a file whose parent folder is ignored, so ignore the
# folder's contents (data/*) and re-include the kept folders, then their CSVs.
data/*
!data/premerge_cleaned_dataset/
!data/cleaned_v2/
!data/premerge_cleaned_dataset/*.csv
!data/cleaned_v2/*.csv

# Generated outputs
combined/
results/

# Tooling
.DS_Store
.ipynb_checkpoints/
__pycache__/
*.egg-info/
.venv/
